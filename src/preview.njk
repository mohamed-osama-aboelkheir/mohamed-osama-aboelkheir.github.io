---
pagination:
  data: themes
  size: 1
  alias: theme
permalink: "/preview/{{ theme.slug }}/"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
{% include "head.njk" %}
<link rel="stylesheet" href="/css/themes/{{ theme.slug }}.css">
<style>
  /* the picker exists only on these preview pages */
  .theme-picker {
    position: sticky; top: 0; z-index: 50;
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
    padding: 10px 16px;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--line);
    font: 500 13px/1.4 ui-sans-serif, system-ui, sans-serif;
  }
  .theme-picker .label { color: var(--text-faint); margin-right: 4px; }
  .theme-picker a {
    padding: 5px 12px; border-radius: 999px;
    border: 1px solid var(--line-strong); color: var(--text);
    text-decoration: none;
  }
  .theme-picker a[aria-current] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .theme-picker .desc { color: var(--text-dim); flex-basis: 100%; font-size: 12px; }
</style>
</head>
<body>
<nav class="theme-picker">
  <span class="label">Theme</span>
  {% for t in themes %}
  <a href="/preview/{{ t.slug }}/" {% if t.slug == theme.slug %}aria-current="page"{% endif %}>{{ t.name }}</a>
  {% endfor %}
  <span class="desc">{{ theme.note }}</span>
</nav>
{% include "page.njk" %}
</body>
</html>
